<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RedBox" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.RedBox.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#09090B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/redbox_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.RedBox</item>
    </style>
</resources>
